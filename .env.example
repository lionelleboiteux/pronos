TYPESAFE_API_KEY=your_typesafe_api_key_here

# Cloudflare credentials for THIS folder only (wrangler and the cf CLI read
# these and they override any `wrangler login` session). Token: dashboard ->
# My Profile -> API Tokens -> "Edit Cloudflare Workers" template, plus
# Zone:DNS:Edit on fantasy-coach.fr for the api.fantasy-coach.fr custom domain.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
